<mxfile host="drawio"><diagram name="field-numbering" id="field-numbering"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" value="Base" parent="0"/><mxCell id="c1" value="Field numbers never change once published" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;field-ids.lock.json&lt;/b&gt;&lt;br&gt;committed with every regeneration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="260" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;First run&lt;/b&gt;&lt;br&gt;numbers follow FOM order,&lt;br&gt;starting at 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="200" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Attribute added&lt;/b&gt;&lt;br&gt;highest number used + 1&lt;br&gt;(19000–19999 skipped)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="180" width="200" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Attribute removed&lt;/b&gt;&lt;br&gt;emitted as &lt;i&gt;reserved&lt;/i&gt;&lt;br&gt;(number and name)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="200" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Attribute renamed&lt;/b&gt;&lt;br&gt;looks like remove + add:&lt;br&gt;new number, flagged for review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710" y="180" width="220" height="80" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Reviewer adds the pair to the lock file's &lt;i&gt;renames&lt;/i&gt; map → the old number is kept" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="300" width="240" height="70" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Why: Protobuf identifies fields on the wire by number. Reusing or changing a number makes old readers decode new data into the wrong field. In CI, buf breaking (WIRE category) flags wire-incompatible changes before they reach main." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="640" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
