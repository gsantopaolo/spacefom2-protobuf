<mxfile host="drawio"><diagram name="data-path" id="data-path"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" value="Base" parent="0"/><mxCell id="c1" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="960" height="560" as="geometry"/></mxCell><mxCell id="c2" value="One update, from a federate to a tool that has never heard of HLA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="920" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Federate&lt;/b&gt;&lt;br&gt;e.g. a vehicle simulation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="170" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;RTI&lt;/b&gt;&lt;br&gt;HLA 4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="140" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Bridge federate&lt;/b&gt;&lt;br&gt;(planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="170" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Kafka / gRPC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710" y="120" width="120" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Consumer&lt;/b&gt;&lt;br&gt;Python, Go, Java, C#,&lt;br&gt;C++, TypeScript" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#333333;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710" y="260" width="230" height="70" as="geometry"/></mxCell><mxCell id="L2" value="Step 1" parent="0"/><mxCell id="e8" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="L2" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;1.&lt;/b&gt; The federate calls UpdateAttributeValues. Each attribute value is opaque HLA-encoded bytes (for example a SpaceTimeCoordinateState as an HLAfixedRecord of HLAfloat64LE). In the HLA 4 Federate Protocol these travel as a Protobuf &lt;i&gt;bytes&lt;/i&gt; field." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="L2"><mxGeometry x="20" y="380" width="920" height="60" as="geometry"/></mxCell><mxCell id="L3" value="Step 2" parent="0"/><mxCell id="e10" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="L3" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;2.&lt;/b&gt; The RTI delivers the update to every subscriber, the bridge included, through ReflectAttributeValues. The bytes are still HLA-encoded." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="L3"><mxGeometry x="20" y="440" width="920" height="40" as="geometry"/></mxCell><mxCell id="L4" value="Step 3" parent="0"/><mxCell id="c12" value="decode with the FOM →&lt;br&gt;PhysicalEntity message" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="L4"><mxGeometry x="470" y="230" width="170" height="50" as="geometry"/></mxCell><mxCell id="e13" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="L4" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;3.&lt;/b&gt; The bridge decodes the bytes using the FOM and fills the generated Protobuf message, for example siso.spacefom.v1.PhysicalEntity." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="20" y="480" width="920" height="40" as="geometry"/></mxCell><mxCell id="L5" value="Step 4" parent="0"/><mxCell id="e15" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="L5" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="L5" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;4.&lt;/b&gt; The bridge publishes the message on Kafka or gRPC. The consumer reads it with code generated from the same .proto, in any language, with no HLA library." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="L5"><mxGeometry x="20" y="520" width="920" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
